    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "bits-ui": "^2.19.3",
    "cn": "^0.4.0",
    "jsdom": "^30.1.1",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
